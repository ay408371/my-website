
.login-body{min-height:100vh;background:#edf6f1}.login-page{min-height:100vh;padding:28px}.login-brand{position:absolute;left:38px;top:30px;z-index:5}.login-card{width:min(980px,calc(100% - 20px));min-height:620px;margin:70px auto 20px;background:#fffdf8;border-radius:28px;overflow:hidden;display:grid;grid-template-columns:44% 56%;box-shadow:0 25px 60px rgba(43,82,68,.12)}.login-art{position:relative;background:#dcefe6;overflow:hidden}.login-blob{position:absolute;width:430px;height:430px;border-radius:48% 52% 58% 42%;background:#b8dcca;left:-125px;bottom:-145px;transform:rotate(14deg)}.coin-stack{position:absolute;width:125px;height:145px;left:65px;top:95px}.coin-stack span{position:absolute;width:75px;height:75px;border-radius:50%;right:0;top:0;background:#ffd09b;display:grid;place-items:center;font-size:30px;font-weight:800;box-shadow:8px 9px 0 #e7a95e}.coin-stack i{position:absolute;width:112px;height:27px;border-radius:50%;background:#6cb59a;left:0;bottom:0;transform:rotate(-8deg);box-shadow:0 -17px 0 #86c6ad,0 -34px 0 #a0d1bc}.login-character{position:absolute;width:175px;height:300px;left:85px;bottom:-10px}.login-hair{position:absolute;width:138px;height:72px;border-radius:70px 70px 25px 25px;background:#26382f;left:18px;top:35px;z-index:3}.login-hair:after{content:'';position:absolute;width:38px;height:75px;border-radius:20px 3px 25px 20px;background:#26382f;right:-12px;top:35px}.login-face{position:absolute;width:124px;height:135px;border-radius:48% 48% 44% 44%;background:#bf805b;left:25px;top:78px;z-index:2}.login-face i{position:absolute;width:8px;height:10px;border-radius:50%;background:#26382f;top:61px}.login-face i:first-child{left:34px}.login-face i:nth-child(2){right:34px}.login-face b{position:absolute;width:24px;height:10px;border-bottom:3px solid #26382f;border-radius:50%;left:50px;top:85px}.login-body-shape{position:absolute;width:175px;height:150px;border-radius:70px 70px 20px 20px;background:#ff8061;bottom:-25px;z-index:1}.login-body-shape span{position:absolute;width:48px;height:48px;border-radius:50%;background:white;color:#2b9879;display:grid;place-items:center;font-size:24px;font-weight:800;left:-20px;top:5px;box-shadow:0 8px 18px rgba(40,78,64,.12)}.login-form-wrap{padding:58px 62px 40px}.login-form-wrap h1{font-size:42px;line-height:1.08;margin:12px 0 10px;letter-spacing:-1.5px}.login-subtitle{color:#718078;margin:0 0 28px}.login-form-wrap form>label{display:block;font-size:13px;font-weight:800;margin:15px 0 7px}.login-form-wrap input[type=email],.login-form-wrap input[type=password],.login-form-wrap input[type=text]{width:100%;height:50px;border:1.5px solid #dde6e1;border-radius:12px;background:#fff;padding:0 15px;font-family:'Nunito',sans-serif;font-size:14px;outline:none}.login-form-wrap input:focus{border-color:#2b9879;box-shadow:0 0 0 3px rgba(43,152,121,.1)}.password-wrap{position:relative}.password-wrap button{position:absolute;right:8px;top:8px;height:34px;border:0;background:#edf6f1;border-radius:8px;color:#507064;font-family:'Nunito',sans-serif;font-weight:800;cursor:pointer}.form-options{display:flex;justify-content:space-between;align-items:center;margin:15px 0 22px;font-size:13px}.remember{display:flex;align-items:center;gap:7px}.remember input{accent-color:#2b9879}.form-options a,.signup-text a{color:#2b9879;font-weight:800}.login-submit{width:100%;height:52px;border:0;border-radius:12px;background:#20352f;color:white;font-family:'Nunito',sans-serif;font-size:15px;font-weight:800;cursor:pointer}.login-submit span{float:right;margin-right:15px}.login-submit:hover{background:#2b9879}.form-message{min-height:18px;text-align:center;font-size:13px;margin:10px 0}.form-message.error{color:#b64f43}.form-message.success{color:#237f68}.signup-text{text-align:center;font-size:13px;color:#718078;margin-top:22px}@media(max-width:760px){.login-page{padding:18px}.login-brand{position:static;margin:8px 0 18px}.login-card{width:100%;min-height:auto;margin:0 auto;grid-template-columns:1fr}.login-art{height:210px}.login-blob{width:310px;height:310px;left:-90px;bottom:-190px}.coin-stack{left:auto;right:35px;top:20px;transform:scale(.72);transform-origin:right top}.login-character{transform:scale(.58);transform-origin:bottom left;left:calc(50% - 75px)}.login-form-wrap{padding:35px 24px}.login-form-wrap h1{font-size:34px}}

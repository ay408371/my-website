<style>
.login-body{min-height:100vh;background:#edf6f1}.login-page{min-height:100vh;padding:28px}.login-brand{position:absolute;left:38px;top:30px;z-index:5}.login-card{width:min(980px,calc(100% - 20px));min-height:620px;margin:70px auto 20px;background:#fffdf8;border-radius:28px;overflow:hidden;display:grid;grid-template-columns:44% 56%;box-shadow:0 25px 60px rgba(43,82,68,.12)}.login-art{position:relative;background:#dcefe6;overflow:hidden}.login-blob{position:absolute;width:430px;height:430px;border-radius:48% 52% 58% 42%;background:#b8dcca;left:-125px;bottom:-145px}.coin-stack{position:absolute;width:125px;height:145px;left:65px;top:95px}.coin-stack span{position:absolute;width:75px;height:75px;border-radius:50%;right:0;top:0;background:#ffd09b;display:grid;place-items:center;font-size:30px;font-weight:800}.login-character{position:absolute;width:175px;height:300px;left:85px;bottom:-10px}.login-hair{position:absolute;width:138px;height:72px;border-radius:70px 70px 25px 25px;background:#26382f;left:18px;top:35px}.login-face{position:absolute;width:124px;height:135px;border-radius:48%;background:#bf805b;left:25px;top:78px}.login-body-shape{position:absolute;width:175px;height:150px;border-radius:70px 70px 20px 20px;background:#ff8061;bottom:-25px}.login-form-wrap{padding:58px 62px 40px}.login-form-wrap h1{font-family:Manrope,sans-serif;font-size:42px;line-height:1.08;margin:12px 0 10px}.login-subtitle{color:#718078;margin:0 0 28px}.login-form-wrap form>label{display:block;font-size:13px;font-weight:800;margin:15px 0 7px}.login-form-wrap input[type=email],.login-form-wrap input[type=password],.login-form-wrap input[type=text]{width:100%;height:50px;border:1.5px solid #dde6e1;border-radius:12px;background:#fff;padding:0 15px;font-family:'DM Sans',sans-serif;font-size:14px}.password-wrap{position:relative}.password-wrap button{position:absolute;right:8px;top:8px;height:34px;border:0;background:#edf6f1;border-radius:8px;color:#507064;font-weight:800}.form-options{display:flex;justify-content:space-between;align-items:center;margin:15px 0 22px;font-size:13px}.remember{display:flex;align-items:center;gap:7px}.form-options a,.signup-text a{color:#2b9879;font-weight:800}.login-submit{width:100%;height:52px;border:0;border-radius:12px;background:#20352f;color:white;font-family:'DM Sans',sans-serif;font-size:15px;font-weight:800}.login-submit span{float:right;margin-right:15px}.form-message{min-height:18px;text-align:center;font-size:13px}.signup-text{text-align:center;font-size:13px;color:#718078}@media(max-width:760px){.login-page{padding:18px}.login-brand{position:static;margin:8px 0 18px}.login-card{width:100%;grid-template-columns:1fr;margin:0}.login-art{height:210px}.login-character{transform:scale(.58);transform-origin:bottom left;left:calc(50% - 75px)}.login-form-wrap{padding:35px 24px}.login-form-wrap h1{font-size:34px}}
</style>
